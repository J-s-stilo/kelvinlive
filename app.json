{
  "name": "Kelvin Live",
  "slug": "kelvinlive",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "splash": {
    "backgroundColor": "#ffffff"
  },
  "plugins": [
    [
      "expo-camera",
      {
        "cameraPermission": "Allow Kelvin Live to access your camera",
        "microphonePermission": "Allow Kelvin Live to access your microphone",
        "recordAudioAndroid": true
      }
    ]
  ],
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.kelvinlive.app"
  },
  "android": {
    "package": "com.kelvinlive.app",
    "adaptiveIcon": {
      "backgroundColor": "#ffffff"
    }
  },
  "sdkVersion": "55.0.0",
  "platforms": [
    "ios",
    "android"
  ],
  "extra": {
    "eas": {
      "projectId": "c45551a5-5f1a-4b25-8488-f71167066fc7"
    }
  }
}
