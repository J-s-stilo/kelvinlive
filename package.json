{
  "name": "lumalive-creator-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:db && npm run build:api && vite build",
    "build:db": "tsc -p packages/db/tsconfig.json",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node apps/api/dist/index.js"
  },
  "dependencies": {
    "@clerk/express": "^1.7.0",
    "@clerk/react": "^6.9.1",
    "@fal-ai/client": "^1.5.0",
    "@neondatabase/serverless": "^1.0.1",
    "@tanstack/react-query": "^5.66.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
